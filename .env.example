# =============================================================================
# Axi Trades — Environment Template (Production)
# Copy to .env and fill every required value. Never commit real secrets.
# =============================================================================

# --- Server ---
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com
# Comma-separated origins allowed by CORS (defaults to APP_URL if empty)
CORS_ORIGINS=https://your-domain.com

# --- Gemini AI (server-side only) ---
GEMINI_API_KEY=

# --- Firebase (client) — ALL required; app will not start without them ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional named Firestore database
VITE_FIREBASE_DATABASE_ID=
# Set true only for local emulator development
VITE_USE_FIREBASE_EMULATORS=false

# --- Admin panel keyboard access (Ctrl/Cmd+Shift+A) ---
VITE_ADMIN_ACCESS_CODE=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Generic webhook / trading signals ---
WEBHOOK_SECRET=

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Financial news (optional; falls back to public RSS) ---
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- SMTP email dispatch (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=AXITRADES Official
SMTP_FROM_EMAIL=

# --- Deposit wallet addresses (optional bootstrap; prefer admin / Firestore) ---
VITE_WALLET_BTC=
VITE_WALLET_ETH=
VITE_WALLET_USDT=
VITE_WALLET_USDT_ERC20=
VITE_WALLET_USDT_BEP20=
VITE_WALLET_USDC=
VITE_WALLET_SOL=
VITE_WALLET_BNB=
VITE_WALLET_XRP=
VITE_WALLET_XRP_MEMO=
VITE_WALLET_TON=
VITE_WALLET_TON_MEMO=
VITE_WALLET_XLM=
VITE_WALLET_XLM_MEMO=

# --- Bank wire details (optional bootstrap; prefer admin / Firestore) ---
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NAME=
VITE_BANK_ACCOUNT_NUMBER=
VITE_BANK_SWIFT=
VITE_BANK_ROUTING=
VITE_BANK_ADDRESS=
VITE_SUPPORT_EMAIL=
